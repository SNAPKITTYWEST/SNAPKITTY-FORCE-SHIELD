# Target — set to current tunnel URL or production domain
TARGET_URL=https://your-tunnel.trycloudflare.com

# WORM chain HMAC secret (copy from .env.local on the server — never commit the real value)
HMAC_SECRET=

# Discord public key (from Discord Developer Portal)
DISCORD_PUBLIC_KEY=

# Optional: production domain for cross-env comparison
PRODUCTION_URL=https://collectivekitty.com
